# Binários compilados (sem extensão, gerados pelo gcc)
*.out
*.exe
*.app

# Objetos e bibliotecas
*.o
*.obj
*.a
*.so
*.dylib
*.dll

# Símbolos de debug
*.dSYM/
*.su
*.idb
*.pdb

# Compile sempre com -o <nome>.out para que o binario caia na regra *.out acima.
# Nao ignore executaveis pelo nome do algoritmo: com core.ignorecase=true (padrao
# no macOS) o padrao casaria tambem com a pasta homonima (ex: BubbleSort/).

# Binarios ja commitados por engano, ignorados por caminho exato (nao por nome,
# pelo motivo acima). Nao ha diretorio com esses caminhos, entao e seguro.
SortAlgorithms/BubbleSort/bubblesort
SortAlgorithms/InsertionSort/InsertionSort
SortAlgorithms/MergeSort/mergesort
SortAlgorithms/SelectionSort/selectionsort
SortAlgorithms/QuickSort/quicksort
SortAlgorithms/ShellSort/shellsort

# macOS
.DS_Store
